{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siyammalik188-cyber/global-scholarship-finder/blob/main/data/scholarships.schema.json",
  "title": "Global Scholarship Finder listing",
  "type": "object",
  "required": ["id", "title", "provider", "officialSource", "applicationUrl", "verificationStatus", "lastVerified"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "provider": { "type": "string", "minLength": 2 },
    "description": { "type": "string" },
    "degreeLevels": { "type": "array", "items": { "type": "string" } },
    "eligibleNationalities": { "type": "array", "items": { "type": "string" } },
    "destinations": { "type": "array", "items": { "type": "string" } },
    "fields": { "type": "array", "items": { "type": "string" } },
    "funding": { "type": "string" },
    "deadline": { "type": ["string", "null"] },
    "requiredDocuments": { "type": "array", "items": { "type": "string" } },
    "officialSource": { "type": "string", "format": "uri", "pattern": "^https://" },
    "applicationUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "verificationStatus": { "enum": ["needs-review", "verified", "expired", "rejected"] },
    "lastVerified": { "type": ["string", "null"], "format": "date" },
    "reviewedBy": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
